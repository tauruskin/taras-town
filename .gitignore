# Taras Town is a pure static site — there is nothing to build and nothing to
# install. This file just keeps operating-system and editor clutter out of git.

# Windows / macOS junk
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
._*

# Editors
.vscode/
.idea/
*.swp
*~

# In case a tool is ever used locally, its output should never be committed:
# what is in this repo must be exactly what GitHub Pages serves.
node_modules/
dist/
build/
.cache/
*.log

# Local Claude Code settings — not part of the game
.claude/

# Test output: screenshots and throwaway browser profiles
tests/screenshots/

# Local-only test helpers, served alongside the game so they share its origin
# (localStorage is per-origin, so a page that seeds a save has to come from the
# same port). These must never ship: what is in this repo is exactly what
# GitHub Pages serves, and a page that hands out 2000 coins is not the game.
test-setup.html
*-check.html
